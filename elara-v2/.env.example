# Copy to .env and fill in. Never commit .env.

# --- LLM provider: auto | anthropic | openai | none ---
ELARA_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults live in src/elara/config/settings.py)
# ELARA_MODEL_FAST=
# ELARA_MODEL_STRONG=

# --- Storage ---
# ELARA_DATA_DIR=~/.local/share/elara

# --- Files: JSON lists of directories ---
# ELARA_READ_DIRS=["~"]
# ELARA_WRITE_DIRS=["~/elara-workspace"]
# Named locations the assistant can open by name ("open my project folder")
# ELARA_NAMED_PATHS={"project": "~/code/my-project"}

# --- Research (all optional; improve rate limits / etiquette) ---
# ELARA_NCBI_API_KEY=
# ELARA_CONTACT_EMAIL=you@example.com
# ELARA_SEMANTIC_SCHOLAR_API_KEY=   # recommended: avoids HTTP 429
# ELARA_RESEARCH_MIN_PRIMARY_RESULTS=3

# --- API server ---
# ELARA_API_HOST=127.0.0.1
# ELARA_API_PORT=8765
# ELARA_API_TOKEN=   # if set, required as "Authorization: Bearer <token>"

# --- Security ---
# ELARA_ENABLE_CODE_EXECUTION=false
# ELARA_DISABLED_TOOLS=[]

# --- Voice ---
# ELARA_TTS_PROVIDER=espeak
# ELARA_TTS_VOICES={"az": "az", "en": "en-us", "tr": "tr"}
# ELARA_STT_MODEL=small
